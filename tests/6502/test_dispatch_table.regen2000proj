  },
  "2071": {
    "user_side_comment": "Loop until scanline $FF is reached"
  },
  "2073": {
    "user_side_comment": "Re-read $D012 to debounce scanline $FF"
  },
  "2076": {
    "user_side_comment": "Wait until scanline $FF finishes (1x/frame)"
  },
  "2078": {
